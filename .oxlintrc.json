{
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": { "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }] },
  "ignorePatterns": ["**/generated/**", "**/dist/**", "target/**", ".superpowers/**", ".claude/**"]
}
